{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Euro-Office shared Renovate preset, use via \"extends\": [\"github>Euro-Office/.github\"]",
  "extends": ["helpers:pinGitHubActionDigests", ":semanticCommits"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Auto-merge everything except major updates once checks pass and the release is 3 days old",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ],
  "customManagers": [
    {
      "description": "Node major installed from NodeSource in Dockerfiles (setup_XX.x)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)[^/]*Dockerfile$/"],
      "matchStrings": ["deb\\.nodesource\\.com/setup_(?<currentValue>\\d+)\\.x"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "description": "Node major set as NODE_VERSION env in workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["NODE_VERSION:\\s*['\"]?(?<currentValue>\\d+)['\"]?"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
